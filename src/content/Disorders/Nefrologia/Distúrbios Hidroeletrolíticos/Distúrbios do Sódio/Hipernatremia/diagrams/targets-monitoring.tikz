\begin{tikzpicture}[clinicalflowchart]
  \matrix (flow) [
    matrix of nodes,
    row sep=8mm,
    column sep=8mm,
    nodes in empty cells,
    nodes={anchor=center}
  ] {
    & |[terminal] (top)| {METAS E MONITORIZA{\c C}{\~A}O} & \\
    & |[decision] (duration)| {Aguda por carga hipert{\^o}nica?} & \\
    |[alertnode] (acute)| {Corre{\c c}{\~a}o mais r{\'a}pida pode ser necess{\'a}ria se sintomas neurol{\'o}gicos} &
    |[resultnode] (chronic)| {Cr{\^o}nica ou desconhecida: queda gradual para evitar edema cerebral} & \\
    & |[infonode] (labs)| {Na a cada 2--4 h no in{\'i}cio se grave, IV, aguda ou com perdas altas} & \\
    & |[processwide] (adjust)| {Ajustar prescri{\c c}{\~a}o por Na observado, diurese, perdas cont{\'i}nuas, glicose, fun{\c c}{\~a}o renal e exame neurol{\'o}gico} & \\
  };

  \draw[arrow] (top.south) -- (duration.north);
  \draw[arrow] (duration.west) -| node[above] {Sim} (acute.north);
  \draw[arrow] (duration.south) -- node[right] {N{\~a}o} (chronic.north);
  \draw[arrow] (acute.east) -- (chronic.west);
  \draw[arrow] (chronic.south) -- (labs.north);
  \draw[arrow] (labs.south) -- (adjust.north);
\end{tikzpicture}
