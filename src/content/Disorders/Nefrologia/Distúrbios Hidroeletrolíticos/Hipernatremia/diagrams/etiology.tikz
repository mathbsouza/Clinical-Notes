\begin{tikzpicture}[clinicalflowchart]
  \matrix (flow) [
    matrix of nodes,
    row sep=8mm,
    column sep=7mm,
    nodes in empty cells,
    nodes={anchor=center}
  ] {
    & & |[terminal] (title)| {HIPERNATREMIA: Na $>145$ mmol/L} & & \\
    & & |[junction] (fork)| {} & & \\
    |[infonode] (aquadep)| {\textbf{Aquadepletiva / aquarestritiva}\\d{\'e}ficit ou restri{\c c}{\~a}o de {\'a}gua livre} &
    |[infonode] (hypotono)| {\textbf{Hipotonodepletiva}\\perda de fluido hipot{\^o}nico} &
    |[alertnode] (hypertono)| {\textbf{Hipertonoacumulativa}\\ganho hipert{\^o}nico de s{\'o}dio} &
    |[process] (access)| {\textbf{Fator permissivo}\\acesso reduzido a {\'a}gua} & \\
    |[note] (aquadepEx)| {Diabetes insipidus central ou nefrog{\^e}nico; perdas insens{\'i}veis sem reposi{\c c}{\~a}o} &
    |[note] (hypotonoEx)| {Diarreia, sudorese, queimaduras, diurese osm{\'o}tica, diur{\'e}ticos} &
    |[note] (hypertonoEx)| {NaCl hipert{\^o}nico, bicarbonato hipert{\^o}nico, intoxica{\c c}{\~a}o por sal} &
    |[note] (accessEx)| {Idoso fr{\'a}gil, delirium, seda{\c c}{\~a}o, ventila{\c c}{\~a}o mec{\^a}nica, lactentes} & \\
  };

  \draw[trunk] (title.south) -- (fork);
  \draw[arrow] (fork) -| (aquadep.north);
  \draw[arrow] (fork) -| (hypotono.north);
  \draw[arrow] (fork) -| (hypertono.north);
  \draw[arrow] (fork) -| (access.north);
  \draw[arrow] (aquadep.south) -- (aquadepEx.north);
  \draw[arrow] (hypotono.south) -- (hypotonoEx.north);
  \draw[arrow] (hypertono.south) -- (hypertonoEx.north);
  \draw[arrow] (access.south) -- (accessEx.north);
\end{tikzpicture}
