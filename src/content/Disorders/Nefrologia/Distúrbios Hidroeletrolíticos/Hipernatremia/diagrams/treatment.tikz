\begin{tikzpicture}[clinicalflowchart]
  \matrix (flow) [
    matrix of nodes,
    row sep=8mm,
    column sep=7mm,
    nodes in empty cells,
    nodes={anchor=center}
  ] {
    & & |[terminal] (start)| {HIPERNATREMIA} & & \\
    & & |[decision] (shock)| {Choque ou hipoperfus{\~a}o?} & & \\
    |[alertnode] (resus)| {Cristaloide isot{\^o}nico at{\'e} perfus{\~a}o adequada} & & |[infonode] (calc)| {Calcular d{\'e}ficit de {\'a}gua, perdas em curso e meta de corre{\c c}{\~a}o} & & \\
    |[resultnode] (after)| {Depois de estabilizar: entrar no plano de {\'a}gua livre} & & |[junction] (mechanismFork)| {} & & \\
    |[resultnode] (aquadep)| {\textbf{Aquadepletiva}\\{\'a}gua enteral ou glicose 5\% IV; tratar DI se presente} &
    |[resultnode] (hypotono)| {\textbf{Hipotonodepletiva}\\repor volume e {\'a}gua livre conforme perfus{\~a}o} &
    |[alertnode] (hypertono)| {\textbf{Hipertonoacumulativa}\\interromper s{\'o}dio; glicose 5\%; diur{\'e}tico ou di{\'a}lise se hipervolemia} & & \\
    & & |[infonode] (monitor)| {Monitorar Na, diurese, glicose, fun{\c c}{\~a}o renal e estado neurol{\'o}gico} & & \\
  };

  \draw[arrow] (start.south) -- (shock.north);
  \draw[arrow] (shock.west) -| node[above] {Sim} (resus.north);
  \draw[arrow] (shock.south) -- node[right] {N{\~a}o} (calc.north);
  \draw[arrow] (resus.south) -- (after.north);
  \draw[arrow] (after.east) -- (calc.west);
  \draw[trunk] (calc.south) -- (mechanismFork);
  \draw[arrow] (mechanismFork) -| (aquadep.north);
  \draw[arrow] (mechanismFork) -| (hypotono.north);
  \draw[arrow] (mechanismFork) -- (hypertono.north);
  \draw[surveillance] (aquadep.south) |- (monitor.west);
  \draw[surveillance] (hypotono.south) -- (monitor.north);
  \draw[surveillance] (hypertono.south) |- (monitor.east);
\end{tikzpicture}
