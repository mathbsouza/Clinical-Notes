\begin{tikzpicture}[
  font=\sffamily\small,
  title/.style={draw=black, fill=white, line width=.7pt, rounded corners=1mm,
    align=center, text width=9cm, minimum height=10mm, inner sep=3mm,
    font=\sffamily\bfseries\normalsize},
  box/.style={draw=black, fill=white, line width=.6pt, rectangle,
    align=center, text width=4.5cm, minimum height=13mm, inner sep=3mm},
  decision/.style={draw=black, fill=white, line width=.6pt, diamond,
    aspect=2.2, align=center, text width=3.2cm, inner sep=1.5mm},
  arrow/.style={draw=black, -{Stealth[scale=1.0]}, line width=.8pt,
    preaction={draw=white, -{Stealth[scale=1.0]}, line width=2.2pt}}
]
  \node[title] (start) {HIPERNATREMIA};
  \node[decision, below=10mm of start] (shock) {Choque ou hipoperfusao?};
  \node[box, below left=13mm and 26mm of shock] (saline) {Cristaloide isotonico ate perfusao adequada};
  \node[box, below right=13mm and 26mm of shock] (water) {Calcular deficit de agua e perdas em curso};
  \node[box, below=14mm of saline] (after) {Depois de estabilizar: agua livre enteral ou glicose 5\% IV};
  \node[box, below=14mm of water, xshift=-28mm] (di) {Poliuria/DI: repor agua e tratar mecanismo; desmopressina se DI central};
  \node[box, below=14mm of water, xshift=28mm] (overload) {Hipervolemia: glicose 5\% + diuretico; considerar dialise};

  \draw[arrow] (start.south) -- (shock.north);
  \draw[arrow] (shock.south) -- ++(0,-4mm) -| (saline.north);
  \draw[arrow] (shock.south) -- ++(0,-4mm) -| (water.north);
  \draw[arrow] (saline.south) -- (after.north);
  \draw[arrow] (water.south) -- ++(0,-4mm) -| (di.north);
  \draw[arrow] (water.south) -- ++(0,-4mm) -| (overload.north);
\end{tikzpicture}
