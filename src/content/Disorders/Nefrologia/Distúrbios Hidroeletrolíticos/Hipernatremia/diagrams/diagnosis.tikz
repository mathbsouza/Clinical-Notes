\begin{tikzpicture}[clinicalflowchart]
  \matrix (flow) [
    matrix of nodes,
    row sep=8mm,
    column sep=7mm,
    nodes in empty cells,
    nodes={anchor=center}
  ] {
    & & |[terminal] (start)| {Na $>145$ mmol/L confirmado} & & \\
    & & |[infonode] (initial)| {Glicose, osmolaridade s{\'e}rica, fun{\c c}{\~a}o renal, diurese, osmolaridade urin{\'a}ria} & & \\
    & & |[decision] (uosm)| {Osm urin{\'a}ria $>600$ mOsm/kg?} & & \\
    & & |[junction] (uosmFork)| {} & & \\
    |[resultnode] (extra)| {\textbf{Sim}\\rim conserva {\'a}gua} &
    |[process] (extraNext)| {Pensar em hipotonodeple{\c c}{\~a}o extrarrenal ou baixo acesso a {\'a}gua} &
    & |[alertnode] (renal)| {\textbf{N{\~a}o}\\urina inadequadamente dilu{\'i}da} &
    |[process] (renalNext)| {Pesquisar perda renal de {\'a}gua ou soluto} \\
    & & |[decision] (polyuria)| {Poli{\'u}ria?} & & \\
    & & |[junction] (polyFork)| {} & & \\
    |[process] (di)| {Diabetes insipidus central ou nefrog{\^e}nico} &
    & |[process] (osmotic)| {Diurese osm{\'o}tica, diur{\'e}ticos ou fase poli{\'u}rica de IRA} &
    & |[process] (insensible)| {Perdas insens{\'i}veis ou baixa ingest{\~a}o dominam} \\
  };

  \draw[arrow] (start.south) -- (initial.north);
  \draw[arrow] (initial.south) -- (uosm.north);
  \draw[trunk] (uosm.south) -- (uosmFork);
  \draw[arrow] (uosmFork) -| (extra.north);
  \draw[arrow] (extra.east) -- (extraNext.west);
  \draw[arrow] (uosmFork) -| (renal.north);
  \draw[arrow] (renal.east) -- (renalNext.west);
  \draw[arrow] (renalNext.south) |- (polyuria.east);
  \draw[trunk] (polyuria.south) -- (polyFork);
  \draw[arrow] (polyFork) -| (di.north);
  \draw[arrow] (polyFork) -- (osmotic.north);
  \draw[arrow] (polyFork) -| (insensible.north);
\end{tikzpicture}
