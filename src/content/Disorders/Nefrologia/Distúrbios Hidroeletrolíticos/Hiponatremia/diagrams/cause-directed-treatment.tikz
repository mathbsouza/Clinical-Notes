\definecolor{floworange}{RGB}{194,91,0}
\definecolor{floworangefill}{RGB}{255,248,239}
\definecolor{flowred}{RGB}{165,29,45}
\definecolor{flowredfill}{RGB}{255,243,243}
\definecolor{flowgreen}{RGB}{39,103,73}
\definecolor{flowgreenfill}{RGB}{241,250,245}
\definecolor{flowblue}{RGB}{45,86,130}
\definecolor{flowbluefill}{RGB}{242,247,252}
\begin{tikzpicture}[scale=.72, transform shape,
  font=\sffamily\footnotesize,
  terminal/.style={draw=flowblue, fill=flowbluefill, line width=.9pt, rounded corners=1mm, align=center, text width=8cm, minimum height=12mm, inner sep=3mm, font=\sffamily\bfseries\small},
  mechanismA/.style={draw=floworange, fill=floworangefill, line width=.9pt, rounded corners=1mm, align=center, text width=4.7cm, minimum height=16mm, inner sep=2.5mm, font=\sffamily\bfseries},
  mechanismB/.style={mechanismA, draw=flowblue, fill=flowbluefill},
  mechanismC/.style={mechanismA, draw=flowgreen, fill=flowgreenfill},
  process/.style={draw=black, fill=white, line width=.6pt, rounded corners=.7mm, align=center, text width=4.7cm, minimum height=27mm, inner sep=2.5mm},
  alert/.style={process, draw=flowred, fill=flowredfill, line width=.8pt},
  endpoint/.style={draw=flowred, fill=flowredfill, line width=.9pt, rounded corners=1mm, align=center, text width=8.5cm, minimum height=18mm, inner sep=3mm, font=\sffamily\bfseries},
  junction/.style={draw=none, fill=none, inner sep=0pt, outer sep=0pt, minimum size=0pt, text width=0pt},
  trunk/.style={draw=black, line width=.8pt},
  dotted/.style={draw=floworange, line width=1.1pt, densely dotted},
  arrow/.style={draw=black, -{Stealth[scale=1.0]}, line width=.8pt}
]
  \matrix (grid) [matrix of nodes, row sep=7mm, column sep=7mm, nodes in empty cells, nodes={anchor=center}] {
    & |[terminal] (start)| {TRATAMENTO DIRIGIDO {\`A} CAUSA\\[-1mm]\scriptsize Qual {\'e} o mecanismo predominante?} & \\
    & |[junction] (fork)| {} & \\
    |[mechanismA] (depletion)| {HIPERTONODEPLETIVA\\[-1mm]\scriptsize Perda de soluto $>$ perda de {\'a}gua} &
    |[mechanismB] (retention)| {AQUACUMULATIVA\\[-1mm]\scriptsize Reten{\c c}{\~a}o de {\'a}gua mediada por ADH} &
    |[mechanismC] (intake)| {HIPOTONOCUMULATIVA\\[-1mm]\scriptsize Entrada hipot{\^o}nica $>$ excre{\c c}{\~a}o} \\
    |[process] (depletioncauses)| {\textbf{CAUSAS}\\Perdas gastrointestinais\\Diur{\'e}ticos/perda renal de sal\\Insufici{\^e}ncia adrenal} &
    |[process] (retentioncauses)| {\textbf{CAUSAS}\\SIAD\\Insufici{\^e}ncia card{\'i}aca/cirrose\\DRC com baixo volume arterial efetivo} &
    |[process] (intakecauses)| {\textbf{CAUSAS}\\Polidipsia prim{\'a}ria\\Potomania\\Dieta extremamente pobre em solutos} \\
    |[alert] (depletionfirst)| {\textbf{Choque/instabilidade}\\Cristaloide isot{\^o}nico em bolus; perfus{\~a}o antes de NaCl 3\%. Ap{\'o}s estabilizar, reavaliar sintomas e monitorar Na/diurese.} &
    |[process] (siad)| {\textbf{SIAD}\\Tratar causa + suspender f{\'a}rmacos\\Restringir 500--1.000 mL/d\\Refrat{\'a}ria: ureia 0,25--0,50 g/kg/d ou al{\c c}a + NaCl oral} &
    |[process] (lowsolute)| {\textbf{Polidipsia/baixo soluto}\\Interromper excesso de {\'a}gua; reintroduzir prote{\'i}na/solutos gradualmente; Na + diurese a cada 2--4 h.} \\
    |[process] (depletionnext)| {\textbf{Ap{\'o}s estabilizar}\\Sintomas moderados/graves: NaCl 3\% 150 mL/20 min at{\'e} $\Delta$Na 4--6. Depois, NaCl 0,9\% 0,5--1 mL/kg/h.} &
    |[process] (effectivevolume)| {\textbf{Baixo volume arterial efetivo}\\Restri{\c c}{\~a}o h{\'i}drica + tratar doen{\c c}a de base; al{\c c}a se congesto; evitar salina isot{\^o}nica.} &
    |[alert] (waterwarning)| {\textbf{Aten{\c c}{\~a}o}\\Intoxica{\c c}{\~a}o h{\'i}drica autoinduzida: n{\~a}o usar DDAVP profil{\'a}tica. Baixo soluto/alto risco de ODS: considerar clamp intensivo.} \\
    |[alert] (adrenal)| {\textbf{Crise adrenal suspeita}\\Colher cortisol se n{\~a}o atrasar; hidrocortisona 100 mg IV/IM agora; depois 200 mg/24 h ou 50 mg 6/6 h + NaCl 0,9\%.} & & \\
    |[junction] (leftmerge)| {} & |[junction] (commonmerge)| {} & |[junction] (rightmerge)| {} \\
    & |[endpoint] (common)| {EM QUALQUER MECANISMO\\[-1mm]\scriptsize Diurese aquosa/proje{\c c}{\~a}o acima do limite: suspender terapia + DDAVP 2 $\mu$g IV/SC 6/6--8/8 h. Limite excedido: SG5\% $\sim3$ mL/kg por queda de Na $\sim1$ mmol/L; Na a cada 2 h.} & \\
  };
  \draw[trunk] (start.south) -- (fork.center);
  \draw[arrow] (fork.center) -| (depletion.north);
  \draw[arrow] (fork.center) -- (retention.north);
  \draw[arrow] (fork.center) -| (intake.north);
  \draw[arrow] (depletion.south) -- (depletioncauses.north);
  \draw[arrow] (retention.south) -- (retentioncauses.north);
  \draw[arrow] (intake.south) -- (intakecauses.north);
  \draw[arrow] (depletioncauses.south) -- (depletionfirst.north);
  \draw[arrow] (retentioncauses.south) -- (siad.north);
  \draw[arrow] (intakecauses.south) -- (lowsolute.north);
  \draw[arrow] (depletionfirst.south) -- (depletionnext.north);
  \draw[arrow] (siad.south) -- (effectivevolume.north);
  \draw[arrow] (lowsolute.south) -- (waterwarning.north);
  \draw[arrow] (depletionnext.south) -- (adrenal.north);
  \draw[dotted] (adrenal.south) -- (leftmerge.center);
  \draw[dotted] (effectivevolume.south) -- (commonmerge.center);
  \draw[dotted] (waterwarning.south) -- (rightmerge.center);
  \draw[dotted] (leftmerge.center) -- (commonmerge.center);
  \draw[dotted] (rightmerge.center) -- (commonmerge.center);
  \draw[arrow] (commonmerge.center) -- (common.north);
\end{tikzpicture}
