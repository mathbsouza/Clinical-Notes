\definecolor{floworange}{RGB}{194,91,0}
\definecolor{floworangefill}{RGB}{255,248,239}
\definecolor{flowred}{RGB}{165,29,45}
\definecolor{flowredfill}{RGB}{255,243,243}
\definecolor{flowgreen}{RGB}{39,103,73}
\definecolor{flowgreenfill}{RGB}{241,250,245}
\begin{tikzpicture}[
  font=\sffamily\footnotesize,
  terminal/.style={draw=floworange, fill=floworangefill, line width=.9pt, rounded corners=1mm, align=center, text width=8cm, minimum height=12mm, inner sep=3mm, font=\sffamily\bfseries\small},
  process/.style={draw=black, fill=white, line width=.6pt, rounded corners=.7mm, align=center, text width=4.7cm, minimum height=30mm, inner sep=2.5mm},
  alert/.style={process, draw=flowred, fill=flowredfill},
  endpoint/.style={draw=flowgreen, fill=flowgreenfill, line width=.8pt, rounded corners=1mm, align=center, text width=8cm, minimum height=12mm, inner sep=3mm, font=\sffamily\bfseries},
  junction/.style={draw=none, fill=none, inner sep=0pt, outer sep=0pt, minimum size=0pt, text width=0pt},
  trunk/.style={draw=black, line width=.8pt},
  merge/.style={draw=floworange, line width=1.1pt, densely dotted},
  arrow/.style={draw=black, -{Stealth[scale=1.0]}, line width=.8pt}
]
  \matrix (grid) [matrix of nodes, row sep=7mm, column sep=6mm, nodes in empty cells, nodes={anchor=center}] {
    & |[terminal] (start)| {OsmU $>100$ mOsm/kg + NaU $>30$ mEq/L\\[-1mm]\scriptsize N{\~a}o concluir SIAD diretamente} & \\
    & |[junction] (fork)| {} & \\
    |[alert] (reliability)| {\textbf{A confiabilidade caiu?}\\[1mm]Diur{\'e}tico recente\\Doen{\c c}a renal\\Coleta ap{\'o}s expans{\~a}o vol{\^e}mica\\[1mm]\scriptsize Interpretar pelo contexto} &
    |[process] (exclude)| {\textbf{Excluir causas demonstr{\'a}veis}\\[1mm]Diur{\'e}tico/perda renal de sal\\Insufici{\^e}ncia adrenal\\Hipotireoidismo\\[1mm]\scriptsize Cortisol 8 h; TSH/T4L; fun{\c c}{\~a}o renal} &
    |[process] (phenotype)| {\textbf{Fen{\'o}tipo compat{\'i}vel?}\\[1mm]Sem deple{\c c}{\~a}o\\Sem edema cl{\'i}nico\\Ingest{\~a}o habitual de {\'a}gua/solutos\\[1mm]\scriptsize SIAD {\'e} exclus{\~a}o} \\
    & & |[process] (criteria)| {\textbf{Crit{\'e}rios necess{\'a}rios para SIAD}\\[1mm]Osm s{\'e}rica $<275$\\OsmU $>100$\\NaU $>30$ com ingest{\~a}o habitual\\Fun{\c c}{\~o}es adrenal, tireoidiana e renal adequadas\\Sem diur{\'e}tico recente} \\
    |[junction] (leftmerge)| {} & |[junction] (centermerge)| {} & |[junction] (rightmerge)| {} \\
    & |[endpoint] (final)| {Integrar mecanismo, exames e contexto cl{\'i}nico\\[-1mm]\scriptsize Tratar a causa confirmada; reservar SIAD para exclus{\~a}o adequada} & \\
  };
  \draw[trunk] (start.south) -- (fork.center);
  \draw[arrow] (fork.center) -| (reliability.north);
  \draw[arrow] (fork.center) -- (exclude.north);
  \draw[arrow] (fork.center) -| (phenotype.north);
  \draw[arrow] (phenotype.south) -- (criteria.north);
  \draw[merge] (reliability.south) -- (leftmerge.center);
  \draw[merge] (exclude.south) -- (centermerge.center);
  \draw[merge] (criteria.south) -- (rightmerge.center);
  \draw[merge] (leftmerge.center) -- (centermerge.center);
  \draw[merge] (rightmerge.center) -- (centermerge.center);
  \draw[arrow] (centermerge.center) -- (final.north);
\end{tikzpicture}
