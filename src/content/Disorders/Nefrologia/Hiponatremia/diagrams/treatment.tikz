\begin{tikzpicture}[
  font=\sffamily\footnotesize,
  terminal/.style={draw=black, fill=white, line width=.7pt, rounded corners=1mm, align=center, text width=8.2cm, minimum height=10mm, inner sep=2.5mm, font=\sffamily\bfseries\small},
  process/.style={draw=black, fill=white, line width=.6pt, rectangle, align=center, text width=5.0cm, minimum height=10mm, inner sep=2.5mm},
  processwide/.style={process, text width=8.2cm},
  decision/.style={draw=black, fill=white, line width=.6pt, diamond, aspect=2.5, align=center, text width=3.8cm, inner sep=1.2mm},
  branch/.style={draw=black, fill=white, line width=.5pt, rounded corners=.6mm, align=center, text width=5.0cm, inner sep=2mm},
  junction/.style={draw=none, fill=none, inner sep=0pt, outer sep=0pt, minimum size=0pt, text width=0pt},
  arrow/.style={draw=black, -{Stealth[scale=1.0]}, line width=.8pt, preaction={draw=white, -{Stealth[scale=1.0]}, line width=2.2pt}},
  trunk/.style={draw=black, line width=.8pt, preaction={draw=white, line width=2.2pt}}
]
  \matrix (grid) [matrix of nodes, row sep=6mm, column sep=6mm, nodes in empty cells] {
    & |[terminal] (start)| {Na $<135$ mmol/L confirmado} & \\
    & |[decision] (symptoms)| {Convuls{\~a}o, coma, desconforto cardiorrespirat{\'o}rio, confus{\~a}o, v{\^o}mitos persistentes ou sonol{\^e}ncia anormal?} & \\
    |[process] (bolus)| {\textbf{SIM: emerg{\^e}ncia}\ NaCl 3\% 150 mL IV em 20 min; checar Na ao final} & & |[process] (tonicity)| {\textbf{N{\~A}O}\ Medir osmolaridade s{\'e}rica, glicose, osmolaridade e Na urin{\'a}rios simultaneamente} \\
    |[decision] (rise)| {Aumento de Na $\geq4$--$6$ mmol/L ou melhora cl{\'i}nica?} & & |[decision] (hypotonic)| {Osmolaridade s{\'e}rica $<275$ mOsm/kg?} \\
    |[process] (repeat)| {\textbf{N{\~A}O}\ Repetir NaCl 3\% 150 mL/20 min, at{\'e} mais 2 vezes; excluir outra causa dos sintomas} & & |[process] (nonhypo)| {\textbf{N{\~A}O}\ Tratar hiperglicemia/osm{\'o}lito; se 275--295, investigar pseudohiponatremia} \\
    |[process] (stop)| {\textbf{SIM}\ Suspender bolus; tratar causa. Na a cada 4 h durante infus{\~a}o. Meta 4--6; limite 10/24 h e 18/48 h; alto risco: 8/24 h} & & |[decision] (urineosm)| {\textbf{SIM}\ Osmolaridade urin{\'a}ria $\leq100$ mOsm/kg?} \\
    & & |[process] (water)| {\textbf{SIM}\ Polidipsia/baixo soluto: restringir {\'a}gua, repor soluto gradualmente; Na + diurese a cada 2--4 h} \\
    & & |[decision] (urinesodium)| {\textbf{N{\~A}O}\ Na urin{\'a}rio $\leq30$ mmol/L?} \\
    & |[junction] (causeFork)| {} & \\
    |[branch] (hypovolemia)| {\textbf{Hipovolemia}\ NaCl 0,9\% a 0,5--1 mL/kg/h; se choque, bolus de cristaloide conforme perfus{\~a}o} & & |[branch] (edema)| {\textbf{Edema/baixo volume arterial}\ Restritar l{\'i}quido, tratar IC/cirrose/DRC; diur{\'e}tico de al{\c c}a se congesto} \\
    & |[processwide] (highurine)| {Se Na urin{\'a}rio $>30$: excluir diur{\'e}tico, insufici{\^e}ncia adrenal/renal/tireoidiana. SIAD: tratar causa + restri{\c c}{\~a}o 500--1.000 mL/d; refrat{\'a}ria: ureia 0,25--0,50 g/kg/d ou al{\c c}a + NaCl oral} & \\
    & |[decision] (overcorrect)| {\textbf{EM QUALQUER RAMO}\ Diurese aquosa ou proje{\c c}{\~a}o acima do limite?} & \\
    & |[processwide] (rescue)| {\textbf{SIM: frear/rebaixar}\ Suspender terapia; desmopressina 2 $\mu$g IV/SC a cada 6--8 h. Se limite excedido, glicose 5\%: cerca de 3 mL/kg reduz Na em $\sim1$ mmol/L; medir Na a cada 2 h} & \\
  };
  \draw[arrow] (start.south) -- (symptoms.north);
  \draw[arrow] (symptoms.west) -| (bolus.north);
  \draw[arrow] (symptoms.east) -| (tonicity.north);
  \draw[arrow] (bolus.south) -- (rise.north);
  \draw[arrow] (rise.south) -- (repeat.north);
  \draw[arrow] (repeat.west) -- ++(-5mm,0) |- (bolus.west);
  \draw[arrow] (rise.east) -- ++(5mm,0) |- (stop.east);
  \draw[arrow] (tonicity.south) -- (hypotonic.north);
  \draw[arrow] (hypotonic.south) -- (nonhypo.north);
  \draw[arrow] (hypotonic.east) -- ++(5mm,0) |- (urineosm.east);
  \draw[arrow] (urineosm.south) -- (water.north);
  \draw[arrow] (urineosm.west) -- ++(-5mm,0) |- (urinesodium.west);
  \draw[trunk] (urinesodium.south) -- (causeFork);
  \draw[arrow] (causeFork) -| (hypovolemia.north);
  \draw[arrow] (causeFork) -| (edema.north);
  \draw[arrow] (urinesodium.east) -- ++(5mm,0) |- (highurine.east);
  \draw[arrow] (highurine.south) -- (overcorrect.north);
  \draw[arrow] (overcorrect.south) -- (rescue.north);
\end{tikzpicture}

