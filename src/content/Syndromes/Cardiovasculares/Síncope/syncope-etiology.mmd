flowchart TD
    A([Síncope]) --> B
    A --> C
    A --> D

    subgraph B[Reflexa / neuromediada]
      direction TB
      B1[Vasovagal]
      B2[Situacional: tosse, micção,<br/>defecação ou deglutição]
      B3[Síndrome do seio carotídeo]
      B4[Formas atípicas]
    end

    subgraph C[Hipotensão ortostática]
      direction TB
      C1[Disfunção autonômica primária]
      C2[Disfunção autonômica secundária]
      C3[Induzida por fármacos]
      C4[Hipovolemia]
    end

    subgraph D[Cardíaca]
      direction TB
      D1[Arritmias: bradi ou taquiarritmias]
      D2[Doença estrutural cardíaca]
      D3[Doença cardiopulmonar:<br/>TEP ou hipertensão pulmonar]
      D4[Isquemia miocárdica]
    end

    classDef root fill:#ea580c,stroke:#fdba74,color:#fff7ed,stroke-width:2px;
    classDef cause fill:#171717,stroke:#fb923c,color:#f5f5f5,stroke-width:2px;
    class A root;
    class B1,B2,B3,B4,C1,C2,C3,C4,D1,D2,D3,D4 cause;
    style B fill:#1c110c,stroke:#fb923c,stroke-width:2px,color:#ffedd5
    style C fill:#1c110c,stroke:#fb923c,stroke-width:2px,color:#ffedd5
    style D fill:#1c110c,stroke:#fb923c,stroke-width:2px,color:#ffedd5
