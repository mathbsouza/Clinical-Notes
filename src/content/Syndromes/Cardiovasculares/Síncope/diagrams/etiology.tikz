\begin{tikzpicture}[
  font=\sffamily\small,
  flow/.style={draw=black, fill=white, line width=.6pt, rounded corners=1mm,
    align=left, text width=4.5cm, inner sep=3mm},
  terminal/.style={flow, align=center, text width=3cm, font=\sffamily\bfseries},
  junction/.style={draw=none, fill=none, inner sep=0pt, outer sep=0pt,
    minimum size=0pt, text width=0pt},
  arrow/.style={draw=black, -{Stealth[scale=1.0]}, line width=.8pt,
    preaction={draw=white, -{Stealth[scale=1.0]}, line width=2.2pt}},
  trunk/.style={draw=black, line width=.8pt,
    preaction={draw=white, line width=2.2pt}}
]
  % Grade: o fork também ocupa uma célula invisível da matriz.
  \matrix (grid) [
    matrix of nodes,
    row sep=6mm,
    column sep=6mm,
    nodes in empty cells
  ] {
    & |[terminal] (syncope)| {S{\'i}ncope} & \\
    & |[junction] (etiologyFork)| {} & \\
    |[flow] (reflex)| {\textbf{Reflexa / neuromediada}\\[2mm]
      $\bullet$ Vasovagal\\ $\bullet$ Situacional: tosse, mic{\c c}{\~a}o, defeca{\c c}{\~a}o ou degluti{\c c}{\~a}o\\
      $\bullet$ S{\'i}ndrome do seio carot{\'i}deo\\ $\bullet$ Formas at{\'i}picas}
    & |[flow] (orthostatic)| {\textbf{Hipotens{\~a}o ortost{\'a}tica}\\[2mm]
      $\bullet$ Disfun{\c c}{\~a}o auton{\^o}mica prim{\'a}ria\\ $\bullet$ Disfun{\c c}{\~a}o auton{\^o}mica secund{\'a}ria\\
      $\bullet$ Induzida por f{\'a}rmacos\\ $\bullet$ Hipovolemia}
    & |[flow] (cardiac)| {\textbf{Card{\'i}aca}\\[2mm]
      $\bullet$ Arritmias: bradi ou taquiarritmias\\ $\bullet$ Doen{\c c}a estrutural card{\'i}aca\\
      $\bullet$ Doen{\c c}a cardiopulmonar: TEP ou hipertens{\~a}o pulmonar\\ $\bullet$ Isquemia mioc{\'a}rdica} \\
  };

  % Conexões somente após a matriz; âncoras e cotovelos explícitos.
  \draw[trunk] (syncope.south) -- (etiologyFork);
  \draw[arrow] (etiologyFork) -| (reflex.north);
  \draw[arrow] (etiologyFork) -- (orthostatic.north);
  \draw[arrow] (etiologyFork) -| (cardiac.north);
\end{tikzpicture}
