\begin{tikzpicture}[
    font=\sffamily\small,
    line/.style={draw=black, -{Stealth[scale=1.0]}, line width=0.8pt},
    box/.style={
        draw,
        fill=white,
        rectangle,
        rounded corners=0.5mm,
        align=center,
        minimum height=8mm,
        text width=#1,
        inner sep=4mm
    },
    box/.default=38mm,
    smallbox/.style={
        draw,
        rectangle,
        rounded corners=0.5mm,
        align=center,
        minimum height=7mm,
        text width=#1,
        inner sep=3mm
    },
    smallbox/.default=30mm,
    titlebox/.style={
        draw,
        fill=white,
        rectangle,
        line width=0.9pt,
        align=center,
        minimum height=10mm,
        text width=110mm,
        inner sep=4mm,
        font=\bfseries\Large
    },
    headbox/.style={
        draw,
        rectangle,
        fill=white,
        align=center,
        minimum height=12mm,
        text width=68mm,
        inner sep=4mm
    },
    prob/.style={font=\bfseries\large},
    sectiontitle/.style={font=\bfseries\large},
    note/.style={font=\small},
    tinytext/.style={font=\footnotesize},
]

% TOP
\node[titlebox] (title) {TRANSIENT LOSS OF CONSCIOUSNESS};

\node[headbox, below=7mm of title] (char) {%
    {\bfseries\Large CHARACTERIZE THE EVENT}\\[1mm]
    \normalsize
    position/trigger + prodrome + witness account\\
    + movements + recovery/confusion
};

\node[below=5mm of char, font=\large] (estimate) {estimate the clinical probability};

% FIRST ROW
\node[box=39mm, below left=17mm and 42mm of estimate] (syncopeTop) {%
    {\bfseries\Large SYNCOPE}\\[2mm]
    \normalsize
    Prolonged sitting or standing,\\
    especially with presyncope,\\
    favors syncope.
};

\node[box=39mm, below=17mm of estimate] (seizureTop) {%
    {\bfseries\Large EPILEPTIC SEIZURE}\\[2mm]
    \normalsize
    Lateral tongue bite/laceration,\\
    head turning, or\\
    abnormal body posturing\\
    favor epileptic seizure.
};

\node[box=39mm, below right=17mm and 42mm of estimate] (ddxTop) {%
    {\bfseries\Large DIFFERENTIAL DIAGNOSES}\\[2mm]
    \normalsize
    Functional/dissociative seizure\\[1mm]
    Metabolic disturbance\\[1mm]
    Intoxication\\[1mm]
    Cerebrovascular/hemorrhagic disease
};

\node[prob, above=4mm of syncopeTop] {$\approx 75\%$};
\node[prob, above=4mm of seizureTop] {$\approx 18\%$};
\node[prob, above=4mm of ddxTop] {$\approx 7\%$};

\draw[line] (title.south) -- (char.north);
\draw[line] (char.south) -- (estimate.north);

\coordinate (branchTop) at ($(estimate.south)+(0,-5mm)$);
\draw[line] (estimate.south) -- (branchTop);

\draw[line] (branchTop) -| (syncopeTop.north);
\draw[line] (branchTop) -- (seizureTop.north);
\draw[line] (branchTop) -| (ddxTop.north);

% REASSESS BAR
\coordinate (leftReassess)  at ($(syncopeTop.south)+(0,-12mm)$);
\coordinate (midReassess)   at ($(seizureTop.south)+(0,-12mm)$);
\coordinate (rightReassess) at ($(ddxTop.south)+(0,-12mm)$);

\draw[line] (syncopeTop.south) -- (leftReassess);
\draw[line] (seizureTop.south) -- (midReassess);
\draw[line] (ddxTop.south) -- (rightReassess);

\draw[line] (leftReassess) -- (rightReassess);
\node[fill=white, inner sep=1.2mm, font=\large] at ($(leftReassess)!0.5!(rightReassess)$) {reassess the probability};

% SECOND ROW LABELS
\node[box=46mm, below=12mm of leftReassess] (probSyncope) {%
    {\bfseries\Large PROBABLE SYNCOPE}
};

\node[box=46mm, below=12mm of rightReassess] (probSeizure) {%
    {\bfseries\Large PROBABLE EPILEPTIC SEIZURE}
};

\draw[line] ($(leftReassess)!0.25!(rightReassess)$) |- (probSyncope.north);
\draw[line] ($(leftReassess)!0.75!(rightReassess)$) |- (probSeizure.north);

% SYNCOPE PATHWAY
\node[box=58mm, below=7mm of probSyncope] (exam) {%
    {\bfseries CARDIAC EXAMINATION + ECG}\\
    {\bfseries + BP AND HR IN THE STANDING POSITION}\\[1mm]
    after 5 min supine\\
    $\rightarrow$ at 1 and 3 min standing
};

\draw[line] (probSyncope.south) -- (exam.north);

\node[box=28mm, below left=12mm and 32mm of exam] (reflex) {%
    {\bfseries\Large REFLEX}\\[1mm]
    \normalsize
    Typical trigger + autonomic\\
    prodrome\\[1mm]
    pain/procedure, heat, or\\
    prolonged standing\\
    + nausea, sweating, or\\
    abdominal discomfort
};

\node[box=28mm, below=12mm of exam] (ortho) {%
    {\bfseries\Large ORTHOSTATIC}\\[1mm]
    \normalsize
    Symptoms on standing\\
    + concordant BP drop\\[1mm]
    SBP drop $\geq$20 or DBP $\geq$10 mmHg\\
    within 3 min
};

\node[box=31mm, below right=12mm and 32mm of exam] (cardiac) {%
    {\bfseries\Large CARDIAC}\\[1mm]
    {\bfseries HIGHEST DISCRIMINATIVE VALUE}\\
    AF/flutter, witnessed cyanosis\\[1mm]
    {\bfseries LOWER ISOLATED VALUE}\\
    structural heart disease/HF,\\
    relevant ECG abnormality*,\\
    chest pain,\\
    dyspnea\\[1mm]
    {\bfseries REDUCES THE PROBABILITY}\\
    no known heart disease\\
    + normal ECG
};

\coordinate (splitSyn) at ($(exam.south)+(0,-9mm)$);
\draw[line] (exam.south) -- (splitSyn);
\draw[line] (splitSyn) -| (reflex.north);
\draw[line] (splitSyn) -- (ortho.north);
\draw[line] (splitSyn) -| (cardiac.north);

\node[smallbox=28mm, below=6mm of reflex] (reflexBottom) {%
    typical pattern $\rightarrow$\\
    clinical diagnosis
};

\node[smallbox=29mm, below=6mm of ortho] (orthoBottom) {%
    $\rightarrow$ evaluate hypovolemia/\\
    bleeding, medications,\\
    or dysautonomia\\[1mm]
    extend testing if\\
    symptoms occur later
};

\node[smallbox=22mm, below left=6mm and 6mm of cardiac] (cardiacLeft) {%
    structural suspicion\\[1mm]
    $\rightarrow$ echocardiography
};

\node[smallbox=31mm, below right=6mm and 6mm of cardiac] (cardiacRight) {%
    arrhythmic suspicion\\[1mm]
    $\rightarrow$ ambulatory ECG monitoring\\
    according to event frequency\\
    Holter/external monitor or\\
    implantable loop recorder
};

\draw[line] (reflex.south) -- (reflexBottom.north);
\draw[line] (ortho.south) -- (orthoBottom.north);

\coordinate (cardSplit) at ($(cardiac.south)+(0,-5mm)$);
\draw[line] (cardiac.south) -- (cardSplit);
\draw[line] (cardSplit) -| (cardiacLeft.north);
\draw[line] (cardSplit) -| (cardiacRight.north);

% SEIZURE PATHWAY
\node[box=58mm, below=7mm of probSeizure] (acuteCause) {%
    {\bfseries SEARCH FOR AN ACUTE PROVOKING CAUSE}\\[1mm]
    glucose (hypo- or marked hyperglycemia)\\
    sodium, calcium, and magnesium\\
    renal and liver function\\
    toxicology, if suspected\\
    CSF, if CNS infection is suspected
};

\draw[line] (probSeizure.south) -- (acuteCause.north);

\node[note, below=5mm of acuteCause] (ifnocause) {if no clear acute provoking cause};

\node[box=58mm, below=5mm of ifnocause] (eeg) {%
    {\bfseries ELECTROENCEPHALOGRAPHY}\\
    {\bfseries + STRUCTURAL NEUROIMAGING}\\[1mm]
    MRI preferred\\
    CT if acute intracranial\\
    evaluation is needed
};

\node[note, below=5mm of eeg] (eegnote) {Normal electroencephalography does not exclude epileptic seizure.};

\draw[line] (acuteCause.south) -- (ifnocause.north);
\draw[line] (ifnocause.south) -- (eeg.north);

\end{tikzpicture}
