\begin{tikzpicture}[
  font=\sffamily\footnotesize,
  terminal/.style={draw=black, fill=white, line width=.7pt, rounded corners=1mm,
    align=center, text width=10cm, minimum height=10mm, inner sep=3mm,
    font=\sffamily\bfseries\large},
  process/.style={draw=black, fill=white, line width=.6pt, rectangle,
    align=center, text width=4.2cm, minimum height=10mm, inner sep=3mm},
  processwide/.style={process, text width=5.6cm},
  decision/.style={draw=black, fill=white, line width=.6pt, diamond,
    aspect=2.2, align=center, text width=3.4cm, inner sep=1.5mm},
  note/.style={draw=black, fill=white, line width=.5pt, rounded corners=.6mm,
    align=center, text width=4.2cm, inner sep=2.5mm},
  arrow/.style={draw=black, -{Stealth[scale=1.0]}, line width=.8pt,
    preaction={draw=white, -{Stealth[scale=1.0]}, line width=2.2pt}},
  label/.style={fill=white, inner sep=1pt, font=\sffamily\scriptsize\bfseries}
]
  % Grade rígida: 10 linhas x 7 colunas (coluna central = 4).
  % Todos os nós são declarados antes de qualquer conexão.
  \matrix (grid) [
    matrix of nodes,
    row sep=13mm,
    column sep=8mm,
    nodes in empty cells
  ] {
    & & & |[terminal] (title)| {TRANSIENT LOSS OF CONSCIOUSNESS} & & & \\
    & & & |[processwide] (characterize)| {\textbf{CHARACTERIZE THE EVENT}\\[1mm]
      position/trigger + prodrome + witness account\\ movements + recovery/confusion} & & & \\
    & & & |[decision] (estimate)| {Estimate the clinical probability} & & & \\
    & |[process] (syncopeTop)| {\textbf{SYNCOPE}\\[1mm] Prolonged sitting or standing, especially with presyncope, favors syncope.}
      & & |[process] (seizureTop)| {\textbf{EPILEPTIC SEIZURE}\\[1mm] Lateral tongue injury, head turning, or abnormal posturing favors seizure.}
      & & |[process] (ddxTop)| {\textbf{DIFFERENTIAL DIAGNOSES}\\[1mm] Functional event; metabolic disturbance; intoxication; cerebrovascular disease.} & \\
    & & & |[process] (reassess)| {Reassess the probability} & & & \\
    & |[process] (probSyncope)| {\textbf{PROBABLE SYNCOPE}}
      & & & & |[process] (probSeizure)| {\textbf{PROBABLE EPILEPTIC SEIZURE}} & \\
    & |[processwide] (exam)| {\textbf{CARDIAC EXAMINATION + ECG}\\
      \textbf{BP AND HR IN THE STANDING POSITION}\\[1mm]
      after 5 min supine $\rightarrow$ at 1 and 3 min standing}
      & & & & |[processwide] (acuteCause)| {\textbf{SEARCH FOR AN ACUTE PROVOKING CAUSE}\\[1mm]
      Glucose; sodium; calcium; magnesium; renal and liver function; toxicology if suspected; CSF if CNS infection is suspected.} & \\
    |[process] (reflex)| {\textbf{REFLEX}\\[1mm] Typical trigger and autonomic prodrome: pain/procedure, heat, prolonged standing, nausea or sweating.}
      & |[process] (ortho)| {\textbf{ORTHOSTATIC}\\[1mm] Symptoms on standing with concordant BP drop: SBP $\geq 20$ or DBP $\geq 10$ mmHg within 3 min.}
      & |[process] (cardiac)| {\textbf{CARDIAC}\\[1mm] AF/flutter, cyanosis, structural disease, ECG abnormality, chest pain or dyspnea.}
      & & & |[note] (noCause)| {If no clear acute provoking cause} & \\
    |[note] (reflexResult)| {Typical pattern $\rightarrow$ clinical diagnosis}
      & |[note] (orthoResult)| {Evaluate hypovolemia, bleeding, medications or dysautonomia; extend testing if symptoms occur later.}
      & |[note] (echo)| {Structural suspicion $\rightarrow$ echocardiography}
      & |[note] (monitor)| {Arrhythmic suspicion $\rightarrow$ ambulatory ECG monitoring according to event frequency}
      & & |[processwide] (eeg)| {\textbf{ELECTROENCEPHALOGRAPHY + STRUCTURAL NEUROIMAGING}\\[1mm]
      MRI preferred; CT for acute intracranial evaluation.} & \\
    & & & & & |[note] (eegNote)| {Normal electroencephalography does not exclude epileptic seizure.} & \\
  };

  % Fluxo central superior.
  \draw[arrow] (title.south) -- (characterize.north);
  \draw[arrow] (characterize.south) -- (estimate.north);

  % Primeira ramificação: cada seta nasce no nó de decisão.
  \draw[arrow] (estimate.west) -- ++(-8mm,0) |- node[label,near start,above] {$\approx 75\%$} (syncopeTop.north);
  \draw[arrow] (estimate.south) -- node[label,left] {$\approx 18\%$} (seizureTop.north);
  \draw[arrow] (estimate.east) -- ++(8mm,0) |- node[label,near start,above] {$\approx 7\%$} (ddxTop.north);

  % Convergência em nó explícito de reavaliação.
  \draw[arrow] (syncopeTop.south) -- ++(0,-6mm) |- (reassess.west);
  \draw[arrow] (seizureTop.south) -- (reassess.north);
  \draw[arrow] (ddxTop.south) -- ++(0,-6mm) |- (reassess.east);

  % Segunda ramificação simétrica.
  \draw[arrow] (reassess.west) -- ++(-8mm,0) |- (probSyncope.north);
  \draw[arrow] (reassess.east) -- ++(8mm,0) |- (probSeizure.north);
  \draw[arrow] (probSyncope.south) -- (exam.north);
  \draw[arrow] (probSeizure.south) -- (acuteCause.north);

  % Classificação da síncope em colunas fixas.
  \draw[arrow] (exam.west) -- ++(-8mm,0) |- (reflex.north);
  \draw[arrow] (exam.south) -- (ortho.north);
  \draw[arrow] (exam.east) -- ++(8mm,0) |- (cardiac.north);
  \draw[arrow] (reflex.south) -- (reflexResult.north);
  \draw[arrow] (ortho.south) -- (orthoResult.north);
  \draw[arrow] (cardiac.south) -- (echo.north);
  \draw[arrow] (cardiac.east) -- ++(8mm,0) |- (monitor.north);

  % Investigação de provável crise epiléptica.
  \draw[arrow] (acuteCause.south) -- (noCause.north);
  \draw[arrow] (noCause.south) -- (eeg.north);
  \draw[arrow] (eeg.south) -- (eegNote.north);
\end{tikzpicture}
