\begin{tikzpicture}[
  font=\sffamily\small,
  terminal/.style={draw=black, fill=white, line width=.7pt, rounded corners=1mm,
    align=center, text width=10cm, minimum height=10mm, inner sep=3mm,
    font=\sffamily\bfseries\normalsize},
  process/.style={draw=black, fill=white, line width=.6pt, rectangle,
    align=center, text width=4.2cm, minimum height=10mm, inner sep=3mm},
  processwide/.style={process, text width=5.6cm},
  decision/.style={draw=black, fill=white, line width=.6pt, diamond,
    aspect=2.2, align=center, text width=3.4cm, inner sep=1.5mm},
  note/.style={draw=black, fill=white, line width=.5pt, rounded corners=.6mm,
    align=center, text width=4.2cm, inner sep=2.5mm},
  branchlabel/.style={draw=black, fill=white, line width=.5pt, rounded corners=.6mm,
    align=center, text width=2.7cm, minimum height=8mm, inner sep=1.5mm,
    font=\sffamily\footnotesize},
  junction/.style={draw=none, fill=none, inner sep=0pt, outer sep=0pt,
    minimum size=0pt, text width=0pt},
  arrow/.style={draw=black, -{Stealth[scale=1.0]}, line width=.8pt,
    preaction={draw=white, -{Stealth[scale=1.0]}, line width=2.2pt}},
  trunk/.style={draw=black, line width=.8pt,
    preaction={draw=white, line width=2.2pt}}
]
  % Grade rígida: nós visíveis e junções invisíveis ocupam células da matriz.
  % Todos os nós são declarados antes de qualquer conexão.
  \matrix (grid) [
    matrix of nodes,
    row sep=6mm,
    column sep=4.5mm,
    nodes in empty cells
  ] {
    & & & |[terminal] (title)| {PERDA TRANSIT{\'O}RIA DA CONSCI{\^E}NCIA} & & & \\
    & & & |[processwide] (characterize)| {\textbf{CARACTERIZAR O EVENTO}\\[1mm]
      posi{\c c}{\~a}o/gatilho + pr{\'o}dromos + relato de testemunha\\ movimentos + recupera{\c c}{\~a}o/confus{\~a}o} & & & \\
    & & & |[decision] (estimate)| {Estimar a probabilidade cl{\'i}nica} & & & \\
    & & & |[junction] (estimateFork)| {} & & & \\
    & |[branchlabel] (preSyncope)| {Probabilidade pr{\'e}-teste\\\textbf{$\approx 75\%$}}
      & & |[branchlabel] (preSeizure)| {Probabilidade pr{\'e}-teste\\\textbf{$\approx 18\%$}}
      & & |[branchlabel] (preDdx)| {Probabilidade pr{\'e}-teste\\\textbf{$\approx 7\%$}} & \\
    & |[process] (syncopeTop)| {\textbf{S{\'I}NCOPE}\\[1mm] Permanecer sentado ou em p{\'e} por tempo prolongado, sobretudo com pr{\'e}-s{\'i}ncope, favorece o diagn{\'o}stico.}
      & & |[process] (seizureTop)| {\textbf{CRISE EPIL{\'E}PTICA}\\[1mm] Les{\~a}o lateral da l{\'i}ngua, desvio da cabe{\c c}a ou postura anormal favorecem crise epil{\'e}ptica.}
      & & |[process] (ddxTop)| {\textbf{DIAGN{\'O}STICOS DIFERENCIAIS}\\[1mm] Evento funcional; dist{\'u}rbio metab{\'o}lico; intoxica{\c c}{\~a}o; doen{\c c}a cerebrovascular.} & \\
    & & & |[process] (reassess)| {Reavaliar a probabilidade} & & & \\
    & & & |[junction] (reassessFork)| {} & & & \\
    & |[process] (probSyncope)| {\textbf{S{\'I}NCOPE PROV{\'A}VEL}}
      & & & & |[process] (probSeizure)| {\textbf{CRISE EPIL{\'E}PTICA PROV{\'A}VEL}} & \\
    & |[processwide] (exam)| {\textbf{EXAME CARD{\'I}ACO + ECG}\\
      \textbf{PA E FC EM ORTOSTASE}\\[1mm]
      ap{\'o}s 5 min em dec{\'u}bito $\rightarrow$ com 1 e 3 min em p{\'e}}
      & & & & |[processwide] (acuteCause)| {\textbf{PESQUISAR CAUSA AGUDA DESENCADEANTE}\\[1mm]
      Glicose; s{\'o}dio; c{\'a}lcio; magn{\'e}sio; fun{\c c}{\~a}o renal e hep{\'a}tica; toxicologia se indicada; LCR se houver suspeita de infec{\c c}{\~a}o do SNC.} & \\
    & |[junction] (examFork)| {} & & & & & \\
    |[process] (reflex)| {\textbf{REFLEXA}\\[1mm] Gatilho t{\'i}pico e pr{\'o}dromos auton{\^o}micos: dor/procedimento, calor, ortostase prolongada, n{\'a}usea ou sudorese.}
      & |[process] (ortho)| {\textbf{ORTOST{\'A}TICA}\\[1mm] Sintomas ao levantar com queda concordante: PAS $\geq 20$ ou PAD $\geq 10$ mmHg em at{\'e} 3 min.}
      & |[process] (cardiac)| {\textbf{CARD{\'I}ACA}\\[1mm] FA/flutter, cianose, cardiopatia estrutural, ECG anormal, dor tor{\'a}cica ou dispneia.}
      & & & |[note] (noCause)| {Se n{\~a}o houver causa aguda desencadeante clara} & \\
    & & |[junction] (cardiacFork)| {} & & & & \\
    |[note] (reflexResult)| {Padr{\~a}o t{\'i}pico $\rightarrow$ diagn{\'o}stico cl{\'i}nico}
      & |[note] (orthoResult)| {Avaliar hipovolemia, sangramento, medicamentos ou disautonomia; prolongar o teste se os sintomas forem tardios.}
      & |[note] (echo)| {Suspeita estrutural $\rightarrow$ ecocardiograma}
      & |[note] (monitor)| {Suspeita arr{\'i}tmica $\rightarrow$ monitoriza{\c c}{\~a}o ambulatorial conforme a frequ{\^e}ncia dos eventos}
      & & |[processwide] (eeg)| {\textbf{ELETROENCEFALOGRAMA + NEUROIMAGEM ESTRUTURAL}\\[1mm]
      Preferir RM; usar TC na avalia{\c c}{\~a}o intracraniana aguda.} & \\
    & & & & & |[note] (eegNote)| {Eletroencefalograma normal n{\~a}o exclui crise epil{\'e}ptica.} & \\
  };

  % Fluxo central superior.
  \draw[arrow] (title.south) -- (characterize.north);
  \draw[arrow] (characterize.south) -- (estimate.north);

  % Fork 1: um tronco e um único barramento horizontal.
  \draw[trunk] (estimate.south) -- (estimateFork);
  \draw[arrow] (estimateFork) -| (preSyncope.north);
  \draw[arrow] (estimateFork) -- (preSeizure.north);
  \draw[arrow] (estimateFork) -| (preDdx.north);
  \draw[arrow] (preSyncope.south) -- (syncopeTop.north);
  \draw[arrow] (preSeizure.south) -- (seizureTop.north);
  \draw[arrow] (preDdx.south) -- (ddxTop.north);

  % Convergência em nó explícito de reavaliação.
  \draw[arrow] (syncopeTop.south) -- ++(0,-6mm) |- (reassess.west);
  \draw[arrow] (seizureTop.south) -- (reassess.north);
  \draw[arrow] (ddxTop.south) -- ++(0,-6mm) |- (reassess.east);

  % Fork 2: os dois ramos compartilham o mesmo Y.
  \draw[trunk] (reassess.south) -- (reassessFork);
  \draw[arrow] (reassessFork) -| (probSyncope.north);
  \draw[arrow] (reassessFork) -| (probSeizure.north);
  \draw[arrow] (probSyncope.south) -- (exam.north);
  \draw[arrow] (probSeizure.south) -- (acuteCause.north);

  % Fork 3: classificação em três colunas fixas.
  \draw[trunk] (exam.south) -- (examFork);
  \draw[arrow] (examFork) -| (reflex.north);
  \draw[arrow] (examFork) -- (ortho.north);
  \draw[arrow] (examFork) -| (cardiac.north);
  \draw[arrow] (reflex.south) -- (reflexResult.north);
  \draw[arrow] (ortho.south) -- (orthoResult.north);
  \draw[trunk] (cardiac.south) -- (cardiacFork);
  \draw[arrow] (cardiacFork) -- (echo.north);
  \draw[arrow] (cardiacFork) -| (monitor.north);

  % Investigação de provável crise epiléptica.
  \draw[arrow] (acuteCause.south) -- (noCause.north);
  \draw[arrow] (noCause.south) -- (eeg.north);
  \draw[arrow] (eeg.south) -- (eegNote.north);
\end{tikzpicture}
