vars: {
  d2-config: {
    layout-engine: elk
    theme-id: 200
  }
}

direction: down
style.fill: "#0a0a0a"

**: {
  &leaf: true
  style.fill: "#171717"
  style.stroke: "#fb923c"
  style.font-color: "#f5f5f5"
  style.border-radius: 10
  style.shadow: true
  style.stroke-width: 2
}

(** -> **)[*]: {
  style.stroke: "#fb923c"
  style.stroke-width: 2
}

syncope: Síncope {
  shape: oval
  style.fill: "#ea580c"
  style.stroke: "#fdba74"
  style.font-color: "#fff7ed"
  style.bold: true
}

reflex: Reflexa / neuromediada {
  grid-columns: 1
  grid-gap: 10
  style.fill: "#1c110c"
  style.stroke: "#fb923c"
  style.font-color: "#ffedd5"
  style.bold: true
  style.border-radius: 14
  style.shadow: true

  vasovagal: Vasovagal
  situational: Situacional — tosse, micção, defecação ou deglutição
  carotid: Síndrome do seio carotídeo
  atypical: Formas atípicas
}

orthostatic: Hipotensão ortostática {
  grid-columns: 1
  grid-gap: 10
  style.fill: "#1c110c"
  style.stroke: "#fb923c"
  style.font-color: "#ffedd5"
  style.bold: true
  style.border-radius: 14
  style.shadow: true

  primary: Disfunção autonômica primária
  secondary: Disfunção autonômica secundária
  drugs: Induzida por fármacos
  hypovolemia: Hipovolemia
}

cardiac: Cardíaca {
  grid-columns: 1
  grid-gap: 10
  style.fill: "#1c110c"
  style.stroke: "#fb923c"
  style.font-color: "#ffedd5"
  style.bold: true
  style.border-radius: 14
  style.shadow: true

  arrhythmias: Arritmias — bradi ou taquiarritmias
  structural: Doença estrutural cardíaca
  cardiopulmonary: Doença cardiopulmonar — TEP ou hipertensão pulmonar
  ischemia: Isquemia miocárdica
}

syncope -> reflex
syncope -> orthostatic
syncope -> cardiac
