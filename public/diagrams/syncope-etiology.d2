vars: {
  d2-config: {
    layout-engine: elk
    theme-id: 200
  }
}

direction: down
style.fill: "#0a0a0a"

**: {
  &leaf: true
  style.fill: "#171717"
  style.stroke: "#fb923c"
  style.font-color: "#f5f5f5"
  style.border-radius: 10
  style.shadow: true
  style.stroke-width: 2
}

(** -> **)[*]: {
  style.stroke: "#fb923c"
  style.stroke-width: 2
}

syncope: Síncope {
  shape: oval
  style.fill: "#ea580c"
  style.stroke: "#fdba74"
  style.font-color: "#fff7ed"
  style.bold: true
}

reflex: Reflexa / neuromediada {
  style.fill: "#431407"
  style.font-color: "#ffedd5"
  style.bold: true
}
orthostatic: Hipotensão ortostática {
  style.fill: "#431407"
  style.font-color: "#ffedd5"
  style.bold: true
}
cardiac: Cardíaca {
  style.fill: "#431407"
  style.font-color: "#ffedd5"
  style.bold: true
}

vasovagal: Vasovagal
situational: |md
  Situacional<br/>tosse, micção, defecação ou deglutição
|
carotid: Síndrome do seio carotídeo
atypical: Formas atípicas
primary: Disfunção autonômica primária
secondary: Disfunção autonômica secundária
drugs: Induzida por fármacos
hypovolemia: Hipovolemia
arrhythmias: |md
  Arritmias<br/>bradi ou taquiarritmias
|
structural: Doença estrutural cardíaca
cardiopulmonary: |md
  Doença cardiopulmonar<br/>TEP ou hipertensão pulmonar
|
ischemia: Isquemia miocárdica

syncope -> reflex
syncope -> orthostatic
syncope -> cardiac
reflex -> vasovagal
reflex -> situational
reflex -> carotid
reflex -> atypical
orthostatic -> primary
orthostatic -> secondary
orthostatic -> drugs
orthostatic -> hypovolemia
cardiac -> arrhythmias
cardiac -> structural
cardiac -> cardiopulmonary
cardiac -> ischemia
